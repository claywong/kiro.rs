/target
/CLAUDE.md
/AGENTS.md
/config.json
/credentials.json
/.idea
/test.json
/admin-ui/node_modules/
/admin-ui/dist/
/admin-ui/tsconfig.tsbuildinfo
/credentials.*
/kiro_balance_cache.json
/kiro_stats.json
# 中转层缓存计量落盘（运行时产物，不入库）
/cache_metering.json
/prompt_cache.json
# 客户端 Key 分发（含明文 API Key，绝对不能提交）
/client_api_keys.json
# 账号分组注册表（运行时产物，不入库）
/groups.json
# 按天滚动的请求用量日志
/usage_log.*.jsonl
/usage_stats.json
# 请求链路追踪 SQLite 库（运行时产物，含 WAL 边车文件）
/traces.db
/traces.db-shm
/traces.db-wal
# 运行时数据目录：凭据、明文客户端 Key、adminApiKey、各类 SQLite 库与用量日志全在这里。
# 上面那些 /xxx 规则只锚定仓库根目录，数据落到子目录后一律失效，所以整目录忽略。
# 入库的模板是根目录的 config.example.json，不在此列。
/config/
# 环境变量（含密钥）
/.env
/.env.*
!/.env.example
# 运行日志（-c 指定工作目录时会落在仓库里）
*.log
# 其余运行时落盘产物：不写 / 前缀，这样换工作目录也能兜住
request_logs.db
request_logs.db-shm
request_logs.db-wal
vendor_events.db
vendor_events.db-shm
vendor_events.db-wal
cost_ledger.json
proxy_pool.json
# 配置/凭据的自动备份（.bak、.bak-<时间戳>）
*.bak
*.bak-*
# 在线更新产生的暂存二进制和备份
*.staged-*
*.backup
.ace-tool/
.codegraph/
.claude/
# Python 工具脚本的字节码缓存
__pycache__/
*.pyc
